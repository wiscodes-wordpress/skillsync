# Copy to .env and fill in. Never commit .env.
#
# Google Cloud → APIs & Services → Credentials → OAuth 2.0 Client (Desktop app)
# Enable: Google Tasks API + Google Calendar API
# Consent screen: User type = External (not Internal); add your account as test user
#
# One-time auth (Tasks + Calendar scopes):
#   node tools/google-oauth-setup.cjs --calendar
#
# Sync:
#   node tools/sync-google-tasks.cjs
#   node tools/sync-google-calendar.cjs
#
# Meetings pull (dashboard):
#   yarn meetings

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Where the OAuth token JSON is written (default: tools/.secrets/google-tasks-token.json)
# JOURNAL_GOOGLE_TOKEN_PATH=

# Optional: DenMercs vault override
# JOURNAL_VAULT_PATH=

# Optional: IANA timezone for timed calendar events (default: America/Chicago)
# JOURNAL_TIMEZONE=America/Chicago

# Optional: Jira browse bases for journal issue links (project prefix → site root)
# JOURNAL_JIRA_BASES={"DCD":"https://lifeway.atlassian.net","QUICK":"https://YOUR-SITE.atlassian.net"}
# Or a single site for every prefix:
# JOURNAL_JIRA_BASE_URL=https://lifeway.atlassian.net
